# Copy to .env on Minerva and fill in the real values.
# .env is gitignored; never commit secrets.

LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_COMPLETION_DEPLOYMENT=gpt-5-2025-08-07
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Paths (Minerva-local; never copy off Minerva)
DATA_DIR=./data
OUTPUT_DIR=./outputs

# Data file names (within DATA_DIR)
NOTES_FILE=full_cohort_notes.xlsx
GOLD_STANDARD_FILE=gold_standard.xlsx
# CSV/XLSX with one EncounterKey column listing the 62 double-coded
# (secondary-adjudicator overlap) encounters; forced into the eval split.
DOUBLE_CODED_FILE=double_coded_keys.csv
# Column in GOLD_STANDARD_FILE with the adjudicated 0/1/2 transport code.
# Used only to stratify the dev draw; never shown to the LLM.
# The gold-standard master file names it "LEO-Transport?".
GOLD_LABEL_COL=LEO-Transport?

# Cost ceiling for a single runner invocation (USD).
# Total validation budget is $10; each iteration draws from it.
COST_CEILING_USD=5.00
